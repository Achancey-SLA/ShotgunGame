            <Font size="41.0" />
         </font>
      </Label>
      <Label fx:id="infoLabel" layoutX="135.0" layoutY="359.0" prefHeight="116.0" prefWidth="784.0" textFill="WHITE">
         <font>
            <Font size="57.0" />
         </font>
      </Label>
      <Label fx:id="scoreLabel" layoutX="760.0" layoutY="25.0" prefHeight="63.0" prefWidth="290.0" text="Score: 0/0">
         <font>
            <Font size="40.0" />
         </font>
      </Label>
   </children>
</Pane>
