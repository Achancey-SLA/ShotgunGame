      <Button fx:id="loadButton" disable="true" layoutX="887.0" layoutY="565.0" mnemonicParsing="false" onAction="#load" prefHeight="150.0" prefWidth="150.0" text="Load" />
      <Label fx:id="usernameLabel" layoutX="246.0" layoutY="627.0" prefHeight="32.0" prefWidth="111.0" text="Username" textFill="WHITE">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <TextField fx:id="nameField" layoutX="214.0" layoutY="659.0" onAction="#nameTyped" onKeyTyped="#nameTyped" />
      <Label fx:id="waitingText" layoutX="10.0" layoutY="10.0" prefHeight="78.0" prefWidth="701.0" text="Waiting for opponent" visible="false">
