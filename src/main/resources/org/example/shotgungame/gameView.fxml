<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.shotgungame.GameController">
   <children>
      <ImageView fx:id="bgView" fitHeight="720.0" fitWidth="1080.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../../../Cowboy.png" />
         </image>
      </ImageView>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ffffff64" height="119.0" layoutX="-13.0" layoutY="-23.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="1096.0" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ffffff64" height="133.0" layoutX="-8.0" layoutY="586.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="401.0" />
      <Label fx:id="bulletText" layoutX="15.0" layoutY="606.0" prefHeight="78.0" prefWidth="353.0">
         <font>
            <Font name="American Typewriter" size="38.0" />
         </font>
      </Label>
      <Button fx:id="startButton" layoutX="17.0" layoutY="624.0" mnemonicParsing="false" onAction="#pressStart" prefHeight="82.0" prefWidth="181.0" text="Start">
